// root object for TypeScript configuration
{
    "compilerOptions": {
        /* Basic Options */
        "target": "ES2020",
        "lib": [
            "ES2020"
        ],
        /* Strict Type-Checking Options */
        "strict": true,
        "types": [
            "@cloudflare/workers-types"
        ],
        /* local type-checking, not compilation */
        "moduleResolution": "Bundler",
        "module": "ESNext",
        "noEmit": true,
    },
    "include": [
        "functions/**/*.ts"
    ]
}